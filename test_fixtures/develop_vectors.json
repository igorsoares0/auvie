{
  "comment": "Shared by Dart (test/core/native) and Kotlin (android/app/src/test, androidTest). Colors are 0-255 sRGB. Expected values were computed independently from the formulas in develop.frag; uv defaults to the center, aspect to 1, curve to identity.",
  "parameters": [
    "exposure", "brightness", "contrast", "highlights", "shadows", "saturation",
    "temperature", "tint", "sharpen", "grain", "fade", "vignette"
  ],
  "vectors": [
    { "name": "neutral is identity", "params": {}, "input": [200, 120, 40], "expected": [200, 120, 40] },
    { "name": "neutral keeps black", "params": {}, "input": [0, 0, 0], "expected": [0, 0, 0] },
    { "name": "neutral keeps white", "params": {}, "input": [255, 255, 255], "expected": [255, 255, 255] },
    { "name": "exposure +0.5 is +1 stop", "params": { "exposure": 0.5 }, "input": [128, 128, 128], "expected": [176, 176, 176] },
    { "name": "exposure -0.5 is -1 stop", "params": { "exposure": -0.5 }, "input": [128, 128, 128], "expected": [92, 92, 92] },
    { "name": "temperature warms", "params": { "temperature": 1 }, "input": [128, 128, 128], "expected": [137, 128, 119] },
    { "name": "tint +1 is magenta", "params": { "tint": 1 }, "input": [128, 128, 128], "expected": [128, 119, 128] },
    { "name": "brightness lifts mids", "params": { "brightness": 1 }, "input": [128, 128, 128], "expected": [172, 172, 172] },
    { "name": "shadows lift black", "params": { "shadows": 1 }, "input": [0, 0, 0], "expected": [64, 64, 64] },
    { "name": "highlights recover white", "params": { "highlights": -1 }, "input": [255, 255, 255], "expected": [191, 191, 191] },
    { "name": "contrast pivots on mid gray", "params": { "contrast": 0.5 }, "input": [128, 128, 128], "expected": [128, 128, 128] },
    { "name": "contrast deepens shadows", "params": { "contrast": 0.5 }, "input": [64, 64, 64], "expected": [32, 32, 32] },
    { "name": "saturation -1 is gray", "params": { "saturation": -1 }, "input": [200, 120, 40], "expected": [131, 131, 131] },
    { "name": "fade lifts black", "params": { "fade": 1 }, "input": [0, 0, 0], "expected": [38, 38, 38] },
    { "name": "fade keeps white", "params": { "fade": 1 }, "input": [255, 255, 255], "expected": [255, 255, 255] },
    { "name": "vignette leaves the center", "params": { "vignette": 1 }, "input": [100, 100, 100], "expected": [100, 100, 100] },
    { "name": "vignette darkens corners", "params": { "vignette": 1 }, "uv": [0, 0], "input": [100, 100, 100], "expected": [40, 40, 40] },
    { "name": "negative vignette lightens corners", "params": { "vignette": -1 }, "uv": [1, 1], "input": [0, 0, 0], "expected": [153, 153, 153] },
    { "name": "curves apply per channel", "params": {}, "curve": "invert", "input": [10, 128, 250], "expected": [245, 127, 5] }
  ]
}
